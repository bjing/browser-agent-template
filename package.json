{
  "name": "browser-agent-template",
  "version": "0.1.0",
  "private": true,
  "description": "Basic TypeScript and Playwright template for browser automation projects.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
